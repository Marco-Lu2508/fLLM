{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fLLM",
  "version": "0.1.4",
  "identifier": "io.github.marco-lu2508.fllm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "fLLM",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Run language models on your own computer",
    "longDescription": "fLLM runs language models on your own computer, on the CPU or any graphics card. Chat, a coding agent and a model manager are built in.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/fllm-rs"]
  }
}