#version 450
// FLLM-SHADER: mv_<fmt>_i | bindings: 0 weights(u32[]) 1 xq(u32[], int8 activations + block scales from quant_act_q8) 2 out(f32[]) 3 bias(f32[]) | push: QPush(48 B) | grid: ceil(rows/NROWS) workgroups (RG: ceil(rows / (NROWS * workgroup size / 8))), split x/y at 65535
// Q4_K matrix-vector product for 1..16 activation rows with int8 activations, same contract and results as mv_idot.comp with FMT_Q4_K but
// laid out for memory bandwidth: eight invocations share one 256-value block and each reads 16 bytes of it with one wide load (32 weights, both
// nibble halves), so every weight byte is fetched once and the scale words are read once per 32 weights instead of once per 8.
// Without RG the 8 invocations of a block step through different blocks of the same rows and the workgroup reduces in shared memory (best for 1 and 2
// activation rows: more loads in flight). With RG (mv_q4_k_g) every group of 8 invocations owns NROWS rows and walks all their blocks, the epilogue
// only adds 8 partial sums per output (3 to 4 times faster than the shared-memory tree from 3 rows on, where the arithmetic dominates).
// Specialization constants: 0 = workgroup size (multiple of 8), 1 = NROWS, 2 = NCOLS (= batch, 1..16).
// Device layout of a Q4_K block (see _q_fmt_q4_k.glsl): plane 0 = 128 qs bytes (bytes (g/2)*32.. hold group g low nibbles for even g, high
// nibbles for odd g), plane 1 = 16 bytes (8 scales, 8 mins), plane 2 = d | dmin << 16.
#extension GL_GOOGLE_include_directive : enable
#include "_q_ext.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 1) const uint NROWS = 2;
layout(constant_id = 2) const uint NCOLS = 1;

#include "_q_common.glsl"

layout(std430, set = 0, binding = 1) readonly buffer XQBuf { uint xq[]; };
layout(std430, set = 0, binding = 2) writeonly buffer OutBuf { float outv[]; };
layout(std430, set = 0, binding = 3) readonly buffer BiasBuf { float biasv[]; };

shared float red[NROWS * NCOLS * gl_WorkGroupSize.x];

void main() {
    const uint WG = gl_WorkGroupSize.x;
    const uint t = gl_LocalInvocationID.x;
    const uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
#ifdef RG
    const uint WROWS = (WG >> 3) * NROWS;   // rows per workgroup: every group of 8 invocations owns NROWS rows
    const uint row0 = group * WROWS + (t >> 3) * NROWS;
#else
    const uint row0 = group * NROWS;
#endif
    const uint xwords = p.cols >> 2;
    const uint xblocks = p.cols >> 5;
    const uint xsum = p.xq_d + p.batch * xblocks;  // word offset of d * (sum of the quantized values) per 32-value block (from quant_act_q8)

    const uint it = t & 7u;        // which 16 bytes of the block
    const uint pair = it >> 1;     // byte rows pair*32 .. +31: groups 2*pair (low nibbles) and 2*pair+1 (high nibbles)
    const uint half_ = it & 1u;    // first or second half of those 32 bytes
    const uint ga = pair * 2u;
    const uint lane = (ga & 3u) << 3;  // bit position of the scale of group ga inside its plane-1 word; group ga+1 is 8 bits above
    // the two invocations that share a group split its 32 values, but the additive term belongs to the whole group: the first one carries it
    const float own_min = half_ == 0u ? 1.0 : 0.0;

    float acc[NROWS][NCOLS];
    [[unroll]] for (uint r = 0; r < NROWS; ++r) {
        [[unroll]] for (uint c = 0; c < NCOLS; ++c) acc[r][c] = 0.0;
    }

#ifdef RG
    // the groups of a workgroup read rows that lie a multiple of a power of two apart: start them at different blocks so that the
    // concurrent reads of a step do not hit the same memory channel / cache set
    const uint b_start = (t >> 3) % p.nb;
    for (uint bi = 0; bi < p.nb; ++bi) {
        const uint b = (bi + b_start) >= p.nb ? (bi + b_start) - p.nb : (bi + b_start);
#else
    for (uint b = t >> 3; b < p.nb; b += WG >> 3) {
#endif
        uvec4 lo[NROWS];
        uvec4 hi[NROWS];
        float ka[NROWS];   // d * scale of group ga / ga+1
        float kb[NROWS];
        float ma[NROWS];   // -dmin * min of group ga / ga+1 (0 for the second half of a group)
        float mb[NROWS];
        [[unroll]] for (uint r = 0; r < NROWS; ++r) {
            const uint row = min(row0 + r, p.rows - 1u);
            const uint g = row * p.nb + b;
            const uint q0 = g * 32u + pair * 8u + half_ * 4u;
            const uvec4 qs = uvec4(w[q0], w[q0 + 1u], w[q0 + 2u], w[q0 + 3u]);
            lo[r] = qs & 0x0F0F0F0Fu;
            hi[r] = (qs >> 4) & 0x0F0F0F0Fu;
            const uint q1 = p.off1 + g * 4u + (pair >> 1);
            const uint scw = w[q1] >> lane;
            const uint mnw = w[q1 + 2u] >> lane;
            const vec2 dm = unpackHalf2x16(w[p.off2 + g]);
            ka[r] = dm.x * float(scw & 255u);
            kb[r] = dm.x * float((scw >> 8) & 255u);
            ma[r] = -dm.y * own_min * float(mnw & 255u);
            mb[r] = -dm.y * own_min * float((mnw >> 8) & 255u);
        }
        [[unroll]] for (uint c = 0; c < NCOLS; ++c) {
            const uint xa0 = c * xwords + b * 64u + ga * 8u + half_ * 4u;
            const uvec4 xa = uvec4(xq[xa0], xq[xa0 + 1u], xq[xa0 + 2u], xq[xa0 + 3u]);
            const uvec4 xb = uvec4(xq[xa0 + 8u], xq[xa0 + 9u], xq[xa0 + 10u], xq[xa0 + 11u]);
            const uint si = c * xblocks + b * 8u + ga;
            const float da = uintBitsToFloat(xq[p.xq_d + si]);
            const float db = uintBitsToFloat(xq[p.xq_d + si + 1u]);
            const float sa = uintBitsToFloat(xq[xsum + si]);
            const float sb = uintBitsToFloat(xq[xsum + si + 1u]);
            [[unroll]] for (uint r = 0; r < NROWS; ++r) {
                const int d_a = idot4acc(lo[r].w, xa.w, idot4acc(lo[r].z, xa.z, idot4acc(lo[r].y, xa.y, idot4(lo[r].x, xa.x))));
                const int d_b = idot4acc(hi[r].w, xb.w, idot4acc(hi[r].z, xb.z, idot4acc(hi[r].y, xb.y, idot4(hi[r].x, xb.x))));
                float v = acc[r][c];
                v = fma(float(d_a), ka[r] * da, v);
                v = fma(float(d_b), kb[r] * db, v);
                v = fma(ma[r], sa, v);
                v = fma(mb[r], sb, v);
                acc[r][c] = v;
            }
        }
    }

    [[unroll]] for (uint r = 0; r < NROWS; ++r) {
        [[unroll]] for (uint c = 0; c < NCOLS; ++c) red[(r * NCOLS + c) * WG + t] = acc[r][c];
    }
    barrier();
#ifdef RG
    // the 8 invocations of a group hold partial sums of the same outputs: one invocation adds them up for each output
    const uint outputs = (WG >> 3) * NROWS * NCOLS;
    for (uint o = t; o < outputs; o += WG) {
        const uint grp = o / (NROWS * NCOLS);
        const uint rc = o % (NROWS * NCOLS);
        const uint r = rc / NCOLS;
        const uint c = rc % NCOLS;
        const uint row = group * WROWS + grp * NROWS + r;
        if (row < p.rows) {
            float v = 0.0;
            [[unroll]] for (uint i = 0; i < 8u; ++i) v += red[rc * WG + grp * 8u + i];
            v *= p.scale;
            if ((p.flags & 1u) != 0u) v += biasv[p.row_base + row];
            outv[c * p.out_stride + p.row_base + row] = v;
        }
    }
#else
    for (uint s = WG >> 1; s > 0u; s >>= 1) {
        if (t < s) {
            [[unroll]] for (uint i = 0; i < NROWS * NCOLS; ++i) red[i * WG + t] += red[i * WG + t + s];
        }
        barrier();
    }
    if (t < NROWS * NCOLS) {
        const uint r = t / NCOLS;
        const uint c = t % NCOLS;
        const uint row = row0 + r;
        if (row < p.rows) {
            float v = red[t * WG] * p.scale;
            if ((p.flags & 1u) != 0u) v += biasv[p.row_base + row];
            outv[c * p.out_stride + p.row_base + row] = v;
        }
    }
#endif
}
