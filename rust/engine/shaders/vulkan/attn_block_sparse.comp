#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: attn_block_sparse | bindings: q,kpool,vpool,sel,meta,out | push: topk,groups,block,heads,kv_heads,dk,dv,stride,block_size,scale,k_base,v_base,row0,rows_total | grid: [heads, rows in this dispatch, 1]
// Attention over the keys of selected blocks (Stream::block_attention, MiniMax-M3), f16 cache. One workgroup of 128 lanes per (row, query head): the lanes
// score the keys of the listed blocks 128 at a time (one key per lane: dot(q, key) * scale), fold the tile into an online softmax and accumulate the value
// rows (lane l owns the value dimensions l, l + 128, ...; dv <= 512). sel = int32 rows x groups x topk: block numbers (blocks of `block` keys), ascending,
// -1 after the last; the head reads the list of indexer head h / (heads / groups). Keys at or beyond lengths[r] (the unfinished last block) are skipped.
// Row r = row0 + gl_WorkGroupID.y (the plan splits long batches into several dispatches). meta = int32: lengths[rows_total], then the block tables
// (rows_total x stride). q is rows x heads x dk, out rows x heads x dv.
#define WG 128
#include "_ops_common.glsl"
#include "_ops_kv.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer QBuf { float q[]; };
layout(std430, binding = 1) readonly buffer KPool { uint kpool[]; };
layout(std430, binding = 2) readonly buffer VPool { uint vpool[]; };
layout(std430, binding = 3) readonly buffer SelBuf { int sel[]; };
layout(std430, binding = 4) readonly buffer MetaBuf { int meta[]; };
layout(std430, binding = 5) buffer OutBuf { float outv[]; };
layout(push_constant) uniform P {
    uint topk;
    uint groups;
    uint block;
    uint heads;
    uint kv_heads;
    uint dk;
    uint dv;
    uint stride;
    uint block_size;
    float scale;
    uint k_base;
    uint v_base;
    uint row0;
    uint rows_total;
} p;

shared float qs[512];
shared float tile_p[WG];
shared uint tile_slot[WG];
shared float red[WG];

float reduce_max(float v) {
    const uint t = gl_LocalInvocationID.x;
    red[t] = v;
    barrier();
    for (uint off = WG / 2u; off > 0u; off >>= 1) {
        if (t < off) red[t] = max(red[t], red[t + off]);
        barrier();
    }
    const float result = red[0];
    barrier();
    return result;
}

float reduce_sum(float v) {
    const uint t = gl_LocalInvocationID.x;
    red[t] = v;
    barrier();
    for (uint off = WG / 2u; off > 0u; off >>= 1) {
        if (t < off) red[t] += red[t + off];
        barrier();
    }
    const float result = red[0];
    barrier();
    return result;
}

void main() {
    const uint t = gl_LocalInvocationID.x;
    const uint h = gl_WorkGroupID.x;
    const uint r = p.row0 + gl_WorkGroupID.y;
    const uint kh = h / (p.heads / p.kv_heads);
    const uint g = h / (p.heads / p.groups);
    const uint n = uint(meta[r]);
    const uint list = (r * p.groups + g) * p.topk;
    for (uint i = t; i < p.dk; i += WG) qs[i] = q[(r * p.heads + h) * p.dk + i];
    barrier();
    float m = NEG;
    float l = 0.0;
    float acc[4] = float[4](0.0, 0.0, 0.0, 0.0);
    const uint npos = p.topk * p.block;
    for (uint t0 = 0u; t0 < npos; t0 += WG) {
        const uint j = t0 + t;
        const int blk = j < npos ? sel[list + j / p.block] : -1;
        const uint pos = blk >= 0 ? uint(blk) * p.block + j % p.block : 0u;
        const bool valid = blk >= 0 && pos < n;
        float s = NEG;
        uint slot = 0u;
        if (valid) {
            slot = uint(meta[p.rows_total + r * p.stride + pos / p.block_size]) * p.block_size + pos % p.block_size;
            const uint base = p.k_base + slot * p.kv_heads * p.dk + kh * p.dk;
            float dotp = 0.0;
            for (uint d = 0u; d < p.dk; d++) dotp += qs[d] * KV_HALF(kpool, base + d);
            s = dotp * p.scale;
        }
        tile_slot[t] = slot;
        const float tmax = reduce_max(s);
        if (tmax <= NEG) break;
        const float mn = max(m, tmax);
        const float corr = exp(m - mn);
        const float pj = valid ? exp(s - mn) : 0.0;
        tile_p[t] = pj;
        const float tsum = reduce_sum(pj);
        l = l * corr + tsum;
        for (uint i = 0u; i < 4u; i++) {
            const uint d = t + i * WG;
            if (d < p.dv) {
                float a = acc[i] * corr;
                for (uint jj = 0u; jj < WG; jj++) {
                    const float pw = tile_p[jj];
                    if (pw != 0.0) a += pw * KV_HALF(vpool, p.v_base + tile_slot[jj] * p.kv_heads * p.dv + kh * p.dv + d);
                }
                acc[i] = a;
            }
        }
        barrier();
        m = mn;
    }
    for (uint i = 0u; i < 4u; i++) {
        const uint d = t + i * WG;
        if (d < p.dv) outv[(r * p.heads + h) * p.dv + d] = l > 0.0 ? acc[i] / l : 0.0;
    }
}
