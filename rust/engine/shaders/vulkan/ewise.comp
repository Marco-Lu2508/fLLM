#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: ewise | bindings: x,gate | push: count,param | grid: [min(ceil(count/256), 65535), 1, 1]
// In-place element-wise operations on x (grid-stride loop over count floats), selected by the macro MODE:
//   0 CLAMP     x = clamp(x, -param, param)                                  (Stream::clamp; gate is not read)
//   2 SCALE     x = x * param                                                (Stream::scale_inplace; gate is not read)
//   1 SOFTPLUS  x = x * softplus(param * gate) / param  (the gate itself above scaled 20)   (Stream::softplus_gate_mul, param = beta)
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

#ifndef MODE
#define MODE 0
#endif

layout(std430, binding = 0) buffer XBuf { float x[]; };
layout(std430, binding = 1) readonly buffer GateBuf { float gate[]; };
layout(push_constant) uniform P {
    uint count;
    float param;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
#if MODE == 0
        x[i] = clamp(x[i], -p.param, p.param);
#elif MODE == 2
        x[i] = x[i] * p.param;
#else
        const float scaled = p.param * gate[i];
        x[i] = x[i] * (scaled > 20.0 ? gate[i] : log(1.0 + exp(scaled)) / p.param);
#endif
    }
}
