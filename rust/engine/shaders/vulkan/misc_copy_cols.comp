#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: misc_copy_cols | bindings: src,dst | push: count,width,dst_stride,dst_col | grid: [min(ceil(count/256), 65535), 1, 1]
// Stream::copy_columns: dst[r * dst_stride + dst_col + c] = src[r * width + c] for r < rows, c < width (count = rows * width). Packs separately projected
// blocks into the wider rows of a layer ([q | k | v] of Kimi Delta Attention). Grid-stride loop.
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer SrcBuf { float src[]; };
layout(std430, binding = 1) buffer DstBuf { float dst[]; };
layout(push_constant) uniform P {
    uint count;
    uint width;
    uint dst_stride;
    uint dst_col;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
        const uint r = i / p.width;
        const uint c = i - r * p.width;
        dst[r * p.dst_stride + p.dst_col + c] = src[i];
    }
}
