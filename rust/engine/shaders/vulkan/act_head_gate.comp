#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: act_head_gate | bindings: x,gate | push: count,dv,beta | grid: [min(ceil(count/256), 65535), 1, 1]
// Per-head attention output gate (Stream::head_gate_mul, Laguna and Step-3.5): x[i] = x[i] * act(gate[i / dv]) in place, one gate value per
// head and row, dv output values per head. Selected by the macro MODE:
//   0 SIGMOID   act(g) = sigmoid(g)                       (beta is not read)
//   1 SOFTPLUS  act(g) = softplus(beta * g) / beta        (the gate itself above scaled 20)
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

#ifndef MODE
#define MODE 0
#endif

layout(std430, binding = 0) buffer XBuf { float x[]; };
layout(std430, binding = 1) readonly buffer GateBuf { float gate[]; };
layout(push_constant) uniform P {
    uint count;
    uint dv;
    float beta;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
        const float g = gate[i / p.dv];
#if MODE == 0
        x[i] = x[i] * sigmoid1(g);
#else
        const float scaled = p.beta * g;
        x[i] = x[i] * (scaled > 20.0 ? g : log(1.0 + exp(scaled)) / p.beta);
#endif
    }
}
