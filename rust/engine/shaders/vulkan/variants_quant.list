# Variants of the quantized linear shaders (package 2). Format: <output name> <source.comp> [-DNAME=VALUE ...]  ('#' starts a comment).
# Naming: mv_<format>_<s|i> = matrix-vector for 1..8 activation rows, mm_<format>_<s|i|c> = matrix-matrix for batch > 8,
#         suffix s = f32 arithmetic (every device), i = int8 activations + integer dot product, c = cooperative matrix (f16 tiles).
# Act-order GPTQ (Q4ZP32/64/128) uses the Q4Z shaders plus the prepass quant_permute / quant_act_q8_perm. See INTERFACE_QUANT.md.
# Lines ending in '#optional' may be skipped by build.rs when the compiler rejects them (cooperative matrix needs glslang >= 12.2).

quant_act_q8 quant_act_q8.comp
quant_act_q8_perm quant_act_q8.comp -DPERM=1
quant_permute quant_permute.comp

mv_q4_0_s mv_scalar.comp -DFMT_Q4_0=1
mv_q4_0_i mv_idot.comp -DFMT_Q4_0=1
mm_q4_0_s mm_scalar.comp -DFMT_Q4_0=1
mm_q4_0_i mm_idot.comp -DFMT_Q4_0=1
mm_q4_0_c mm_coopmat.comp -DFMT_Q4_0=1 #optional
mm_q4_0_cw mm_coopmat_w.comp -DFMT_Q4_0=1 #optional

mv_q4_1_s mv_scalar.comp -DFMT_Q4_1=1
mv_q4_1_i mv_idot.comp -DFMT_Q4_1=1
mm_q4_1_s mm_scalar.comp -DFMT_Q4_1=1
mm_q4_1_i mm_idot.comp -DFMT_Q4_1=1
mm_q4_1_c mm_coopmat.comp -DFMT_Q4_1=1 #optional
mm_q4_1_cw mm_coopmat_w.comp -DFMT_Q4_1=1 #optional

mv_q5_0_s mv_scalar.comp -DFMT_Q5_0=1
mv_q5_0_i mv_idot.comp -DFMT_Q5_0=1
mm_q5_0_s mm_scalar.comp -DFMT_Q5_0=1
mm_q5_0_i mm_idot.comp -DFMT_Q5_0=1
mm_q5_0_c mm_coopmat.comp -DFMT_Q5_0=1 #optional
mm_q5_0_cw mm_coopmat_w.comp -DFMT_Q5_0=1 #optional

mv_q5_1_s mv_scalar.comp -DFMT_Q5_1=1
mv_q5_1_i mv_idot.comp -DFMT_Q5_1=1
mm_q5_1_s mm_scalar.comp -DFMT_Q5_1=1
mm_q5_1_i mm_idot.comp -DFMT_Q5_1=1
mm_q5_1_c mm_coopmat.comp -DFMT_Q5_1=1 #optional
mm_q5_1_cw mm_coopmat_w.comp -DFMT_Q5_1=1 #optional

mv_q8_0_s mv_scalar.comp -DFMT_Q8_0=1
mv_q8_0_i mv_idot.comp -DFMT_Q8_0=1
mm_q8_0_s mm_scalar.comp -DFMT_Q8_0=1
mm_q8_0_i mm_idot.comp -DFMT_Q8_0=1
mm_q8_0_c mm_coopmat.comp -DFMT_Q8_0=1 #optional
mm_q8_0_cw mm_coopmat_w.comp -DFMT_Q8_0=1 #optional

mv_q2_k_s mv_scalar.comp -DFMT_Q2_K=1
mv_q2_k_i mv_idot.comp -DFMT_Q2_K=1
mm_q2_k_s mm_scalar.comp -DFMT_Q2_K=1
mm_q2_k_i mm_idot.comp -DFMT_Q2_K=1
mm_q2_k_c mm_coopmat.comp -DFMT_Q2_K=1 #optional
mm_q2_k_cw mm_coopmat_w.comp -DFMT_Q2_K=1 #optional

mv_q3_k_s mv_scalar.comp -DFMT_Q3_K=1
mv_q3_k_i mv_idot.comp -DFMT_Q3_K=1
mm_q3_k_s mm_scalar.comp -DFMT_Q3_K=1
mm_q3_k_i mm_idot.comp -DFMT_Q3_K=1
mm_q3_k_c mm_coopmat.comp -DFMT_Q3_K=1 #optional
mm_q3_k_cw mm_coopmat_w.comp -DFMT_Q3_K=1 #optional

mv_q4_k_s mv_scalar.comp -DFMT_Q4_K=1
mv_q4_k_i mv_q4k_idot.comp
mm_q4_k_s mm_scalar.comp -DFMT_Q4_K=1
mm_q4_k_i mm_idot.comp -DFMT_Q4_K=1
mm_q4_k_c mm_coopmat.comp -DFMT_Q4_K=1 #optional
mm_q4_k_cw mm_coopmat_w.comp -DFMT_Q4_K=1 #optional

mv_q5_k_s mv_scalar.comp -DFMT_Q5_K=1
mv_q5_k_i mv_idot.comp -DFMT_Q5_K=1
mm_q5_k_s mm_scalar.comp -DFMT_Q5_K=1
mm_q5_k_i mm_idot.comp -DFMT_Q5_K=1
mm_q5_k_c mm_coopmat.comp -DFMT_Q5_K=1 #optional
mm_q5_k_cw mm_coopmat_w.comp -DFMT_Q5_K=1 #optional

mv_q6_k_s mv_scalar.comp -DFMT_Q6_K=1
mv_q6_k_i mv_q6k_idot.comp
mm_q6_k_s mm_scalar.comp -DFMT_Q6_K=1
mm_q6_k_i mm_idot.comp -DFMT_Q6_K=1
mm_q6_k_c mm_coopmat.comp -DFMT_Q6_K=1 #optional
mm_q6_k_cw mm_coopmat_w.comp -DFMT_Q6_K=1 #optional

mv_iq4_nl_s mv_scalar.comp -DFMT_IQ4_NL=1
mv_iq4_nl_i mv_idot.comp -DFMT_IQ4_NL=1
mm_iq4_nl_s mm_scalar.comp -DFMT_IQ4_NL=1
mm_iq4_nl_i mm_idot.comp -DFMT_IQ4_NL=1
mm_iq4_nl_c mm_coopmat.comp -DFMT_IQ4_NL=1 #optional
mm_iq4_nl_cw mm_coopmat_w.comp -DFMT_IQ4_NL=1 #optional

mv_mxfp4_s mv_scalar.comp -DFMT_MXFP4=1
mv_mxfp4_i mv_idot.comp -DFMT_MXFP4=1
mm_mxfp4_s mm_scalar.comp -DFMT_MXFP4=1
mm_mxfp4_i mm_idot.comp -DFMT_MXFP4=1
mm_mxfp4_c mm_coopmat.comp -DFMT_MXFP4=1 #optional
mm_mxfp4_cw mm_coopmat_w.comp -DFMT_MXFP4=1 #optional

mv_nvfp4_s mv_scalar.comp -DFMT_NVFP4=1
mv_nvfp4_i mv_idot.comp -DFMT_NVFP4=1
mm_nvfp4_s mm_scalar.comp -DFMT_NVFP4=1
mm_nvfp4_i mm_idot.comp -DFMT_NVFP4=1
mm_nvfp4_c mm_coopmat.comp -DFMT_NVFP4=1 #optional
mm_nvfp4_cw mm_coopmat_w.comp -DFMT_NVFP4=1 #optional

mv_q4z32_s mv_scalar.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=32
mv_q4z32_i mv_idot.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=32
mm_q4z32_s mm_scalar.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=32
mm_q4z32_i mm_idot.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=32
mm_q4z32_c mm_coopmat.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=32 #optional
mm_q4z32_cw mm_coopmat_w.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=32 #optional

mv_q4z64_s mv_scalar.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=64
mv_q4z64_i mv_idot.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=64
mm_q4z64_s mm_scalar.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=64
mm_q4z64_i mm_idot.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=64
mm_q4z64_c mm_coopmat.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=64 #optional
mm_q4z64_cw mm_coopmat_w.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=64 #optional

mv_q4z128_s mv_scalar.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=128
mv_q4z128_i mv_idot.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=128
mm_q4z128_s mm_scalar.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=128
mm_q4z128_i mm_idot.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=128
mm_q4z128_c mm_coopmat.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=128 #optional
mm_q4z128_cw mm_coopmat_w.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=128 #optional


# Prompt-path matrix-matrix kernels (mm_q.comp): tiled, double-buffered, bank-conflict free, scale folded per group. The planner uses them for batch >= FLLM_VK_MM_MIN_BATCH
# on devices with the int8 dot product; mm_<fmt>_i stays the fallback (FLLM_VK_MM=legacy).
mmq_q4_0_i mm_q.comp -DFMT_Q4_0=1
mmq_q4_1_i mm_q.comp -DFMT_Q4_1=1
mmq_q5_0_i mm_q.comp -DFMT_Q5_0=1
mmq_q5_1_i mm_q.comp -DFMT_Q5_1=1
mmq_q8_0_i mm_q.comp -DFMT_Q8_0=1
mmq_q2_k_i mm_q.comp -DFMT_Q2_K=1
mmq_q3_k_i mm_q.comp -DFMT_Q3_K=1
mmq_q4_k_i mm_q.comp -DFMT_Q4_K=1
mmq_q5_k_i mm_q.comp -DFMT_Q5_K=1
mmq_q6_k_i mm_q.comp -DFMT_Q6_K=1
mmq_iq4_nl_i mm_q.comp -DFMT_IQ4_NL=1
mmq_mxfp4_i mm_q.comp -DFMT_MXFP4=1
mmq_nvfp4_i mm_q.comp -DFMT_NVFP4=1
mmq_q4z32_i mm_q.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=32
mmq_q4z64_i mm_q.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=64
mmq_q4z128_i mm_q.comp -DFMT_Q4Z=1 -DQ4Z_GROUP=128

# Native formats of the other backends (docs/gpu-backends.md): block-wise FP8, bitsandbytes NF4 / FP4 / int8, MLX affine group quantization.
# FP8B, NF4 and FP4 decode to floats (E4M3 values and code books are no small integers): only the f32 shaders mv_<fmt>_s / mm_<fmt>_s exist for them.
# INT8R and MLX (one shader per bit width; the group size and the scale type travel in the push constants) decode to int8 lanes: all variants.
mv_fp8b_s mv_scalar.comp -DFMT_FP8B=1
mm_fp8b_s mm_scalar.comp -DFMT_FP8B=1
mv_nf4b64_s mv_scalar.comp -DFMT_NF4=1 -DBNB_QK=64
mm_nf4b64_s mm_scalar.comp -DFMT_NF4=1 -DBNB_QK=64
mv_nf4b128_s mv_scalar.comp -DFMT_NF4=1 -DBNB_QK=128
mm_nf4b128_s mm_scalar.comp -DFMT_NF4=1 -DBNB_QK=128
mv_fp4b64_s mv_scalar.comp -DFMT_FP4=1 -DBNB_QK=64
mm_fp4b64_s mm_scalar.comp -DFMT_FP4=1 -DBNB_QK=64
mv_fp4b128_s mv_scalar.comp -DFMT_FP4=1 -DBNB_QK=128
mm_fp4b128_s mm_scalar.comp -DFMT_FP4=1 -DBNB_QK=128

mv_int8r_s mv_scalar.comp -DFMT_INT8R=1
mv_int8r_i mv_idot.comp -DFMT_INT8R=1
mm_int8r_s mm_scalar.comp -DFMT_INT8R=1
mm_int8r_i mm_idot.comp -DFMT_INT8R=1
mm_int8r_c mm_coopmat.comp -DFMT_INT8R=1 #optional
mm_int8r_cw mm_coopmat_w.comp -DFMT_INT8R=1 #optional
mmq_int8r_i mm_q.comp -DFMT_INT8R=1
mv_mlx2_s mv_scalar.comp -DFMT_MLX=1 -DMLX_BITS=2
mv_mlx2_i mv_idot.comp -DFMT_MLX=1 -DMLX_BITS=2
mm_mlx2_s mm_scalar.comp -DFMT_MLX=1 -DMLX_BITS=2
mm_mlx2_i mm_idot.comp -DFMT_MLX=1 -DMLX_BITS=2
mm_mlx2_c mm_coopmat.comp -DFMT_MLX=1 -DMLX_BITS=2 #optional
mm_mlx2_cw mm_coopmat_w.comp -DFMT_MLX=1 -DMLX_BITS=2 #optional
mmq_mlx2_i mm_q.comp -DFMT_MLX=1 -DMLX_BITS=2
mv_mlx3_s mv_scalar.comp -DFMT_MLX=1 -DMLX_BITS=3
mv_mlx3_i mv_idot.comp -DFMT_MLX=1 -DMLX_BITS=3
mm_mlx3_s mm_scalar.comp -DFMT_MLX=1 -DMLX_BITS=3
mm_mlx3_i mm_idot.comp -DFMT_MLX=1 -DMLX_BITS=3
mm_mlx3_c mm_coopmat.comp -DFMT_MLX=1 -DMLX_BITS=3 #optional
mm_mlx3_cw mm_coopmat_w.comp -DFMT_MLX=1 -DMLX_BITS=3 #optional
mmq_mlx3_i mm_q.comp -DFMT_MLX=1 -DMLX_BITS=3
mv_mlx4_s mv_scalar.comp -DFMT_MLX=1 -DMLX_BITS=4
mv_mlx4_i mv_idot.comp -DFMT_MLX=1 -DMLX_BITS=4
mm_mlx4_s mm_scalar.comp -DFMT_MLX=1 -DMLX_BITS=4
mm_mlx4_i mm_idot.comp -DFMT_MLX=1 -DMLX_BITS=4
mm_mlx4_c mm_coopmat.comp -DFMT_MLX=1 -DMLX_BITS=4 #optional
mm_mlx4_cw mm_coopmat_w.comp -DFMT_MLX=1 -DMLX_BITS=4 #optional
mmq_mlx4_i mm_q.comp -DFMT_MLX=1 -DMLX_BITS=4
mv_mlx5_s mv_scalar.comp -DFMT_MLX=1 -DMLX_BITS=5
mv_mlx5_i mv_idot.comp -DFMT_MLX=1 -DMLX_BITS=5
mm_mlx5_s mm_scalar.comp -DFMT_MLX=1 -DMLX_BITS=5
mm_mlx5_i mm_idot.comp -DFMT_MLX=1 -DMLX_BITS=5
mm_mlx5_c mm_coopmat.comp -DFMT_MLX=1 -DMLX_BITS=5 #optional
mm_mlx5_cw mm_coopmat_w.comp -DFMT_MLX=1 -DMLX_BITS=5 #optional
mmq_mlx5_i mm_q.comp -DFMT_MLX=1 -DMLX_BITS=5
mv_mlx6_s mv_scalar.comp -DFMT_MLX=1 -DMLX_BITS=6
mv_mlx6_i mv_idot.comp -DFMT_MLX=1 -DMLX_BITS=6
mm_mlx6_s mm_scalar.comp -DFMT_MLX=1 -DMLX_BITS=6
mm_mlx6_i mm_idot.comp -DFMT_MLX=1 -DMLX_BITS=6
mm_mlx6_c mm_coopmat.comp -DFMT_MLX=1 -DMLX_BITS=6 #optional
mm_mlx6_cw mm_coopmat_w.comp -DFMT_MLX=1 -DMLX_BITS=6 #optional
mmq_mlx6_i mm_q.comp -DFMT_MLX=1 -DMLX_BITS=6
mv_mlx8_s mv_scalar.comp -DFMT_MLX=1 -DMLX_BITS=8
mv_mlx8_i mv_idot.comp -DFMT_MLX=1 -DMLX_BITS=8
mm_mlx8_s mm_scalar.comp -DFMT_MLX=1 -DMLX_BITS=8
mm_mlx8_i mm_idot.comp -DFMT_MLX=1 -DMLX_BITS=8
mm_mlx8_c mm_coopmat.comp -DFMT_MLX=1 -DMLX_BITS=8 #optional
mm_mlx8_cw mm_coopmat_w.comp -DFMT_MLX=1 -DMLX_BITS=8 #optional
mmq_mlx8_i mm_q.comp -DFMT_MLX=1 -DMLX_BITS=8

# ExLlamaV2 (EXL2): integer chunks like the other formats; the activations go through the permutation prepass (quant_permute / quant_act_q8_perm) as for act-order GPTQ.
mv_exl2_s mv_scalar.comp -DFMT_EXL2=1
mv_exl2_i mv_idot.comp -DFMT_EXL2=1
mm_exl2_s mm_scalar.comp -DFMT_EXL2=1
mm_exl2_i mm_idot.comp -DFMT_EXL2=1
mm_exl2_c mm_coopmat.comp -DFMT_EXL2=1 #optional
mmq_exl2_i mm_q.comp -DFMT_EXL2=1
