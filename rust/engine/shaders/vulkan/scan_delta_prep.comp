#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: scan_delta_prep | bindings: mixed,beta,alpha,dt_bias,decay,scratch | push: kh,vh,hk,hv,conv_dim,tiled,row0,n,slots,beta_scale | grid: [n, 1, 1] per run window
// Gated DeltaNet, chunk-parallel scan (see _scan_common.glsl; port of scan_delta_prep_kernel in cuda/scan.cu): brings the rows row0 .. row0+n-1 of `mixed`
// (the output of delta_conv) into the layout of the scan. P_t = (I - sigma k k^T) g P_{t-1} + sigma k v^T, i.e. w = g, a = g k, b = kp = sigma k with
// lw = decay * softplus(alpha + dt_bias) (clamped), sigma = beta_scale * sigmoid(beta). One workgroup per token, vh <= 256.
#define WG 256
#include "_ops_common.glsl"
#include "_scan_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer MixedBuf { float mixed[]; };
layout(std430, binding = 1) readonly buffer BetaBuf { float beta[]; };
layout(std430, binding = 2) readonly buffer AlphaBuf { float alpha[]; };
layout(std430, binding = 3) readonly buffer DtBuf { float dt_bias[]; };
layout(std430, binding = 4) readonly buffer DecayBuf { float decay[]; };
layout(std430, binding = 5) buffer ScratchBuf { float sc[]; };
layout(push_constant) uniform P {
    uint kh;
    uint vh;
    uint hk;
    uint hv;
    uint conv_dim;
    uint tiled;
    uint row0;
    uint n;
    uint slots;
    float beta_scale;
} p;

shared float s_lw[256];
shared float s_sig[256];

void main() {
    const uint t = gl_WorkGroupID.x;
    if (t >= p.n) return;
    const uint tid = gl_LocalInvocationID.x;
    const ScanLay y = scan_layout(p.hk, p.hv, p.vh, SF_RANK1 | SF_BSAME, p.slots);
    const uint vh = p.vh;
    const uint hk = p.hk;
    const uint hv = p.hv;
    const uint row = p.row0 + t;
    const uint key_dim = p.kh * hk;
    for (uint j = tid; j < vh; j += WG) {
        const float raw = alpha[row * vh + j] + dt_bias[j];
        const float lw = max(decay[j] * softplus20(raw), SLW_MIN);
        s_lw[j] = lw;
        s_sig[j] = p.beta_scale / (1.0 + exp(-beta[row * vh + j]));
        sc[y.lw + t * vh + j] = lw;
    }
    barrier();
    const uint m = row * p.conv_dim;
    for (uint e = tid; e < vh * hk; e += WG) {
        const uint j = e / hk;
        const uint i = e - j * hk;
        const uint src = p.tiled != 0u ? j % p.kh : j / (vh / p.kh);
        const float k = mixed[m + key_dim + src * hk + i];
        const uint at = t * vh * hk + e;
        sc[y.q + at] = mixed[m + src * hk + i];
        sc[y.kp + at] = k * s_sig[j];
        sc[y.a + at] = k * exp(s_lw[j]);
    }
    for (uint e = tid; e < vh * hv; e += WG) sc[y.v + t * vh * hv + e] = mixed[m + 2u * key_dim + e];
}
