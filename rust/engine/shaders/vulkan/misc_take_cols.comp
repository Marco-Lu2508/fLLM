#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: misc_take_cols | bindings: src,dst | push: count,width,src_stride,src_col | grid: [min(ceil(count/256), 65535), 1, 1]
// Stream::take_columns, the inverse of misc_copy_cols: dst[r * width + c] = src[r * src_stride + src_col + c] for r < rows, c < width (count = rows * width).
// Takes the block of one layer out of the wider rows of the Gemma per-layer inputs. Grid-stride loop.
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer SrcBuf { float src[]; };
layout(std430, binding = 1) buffer DstBuf { float dst[]; };
layout(push_constant) uniform P {
    uint count;
    uint width;
    uint src_stride;
    uint src_col;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
        const uint r = i / p.width;
        const uint c = i - r * p.width;
        dst[i] = src[r * p.src_stride + p.src_col + c];
    }
}
