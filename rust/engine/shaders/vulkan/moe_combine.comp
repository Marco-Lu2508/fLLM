#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: moe_combine | bindings: out,y,weights | push: tokens,k,hidden | grid: [min(ceil(tokens*hidden/256), 65535), 1, 1]
// Stream::moe_combine: out[t][h] = sum_j weights[t * k + j] * y[(t * k + j) * hidden + h] for t < tokens, h < hidden (grid-stride loop).
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer OutBuf { float o[]; };
layout(std430, binding = 1) readonly buffer YBuf { float y[]; };
layout(std430, binding = 2) readonly buffer WeightBuf { float weights[]; };
layout(push_constant) uniform P {
    uint tokens;
    uint k;
    uint hidden;
} p;

void main() {
    const uint total = p.tokens * p.hidden;
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < total; i += grid_items) {
        const uint t = i / p.hidden;
        const uint h = i - t * p.hidden;
        float acc = 0.0;
        for (uint j = 0u; j < p.k; j++) acc += weights[t * p.k + j] * y[(t * p.k + j) * p.hidden + h];
        o[i] = acc;
    }
}
