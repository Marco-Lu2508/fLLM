#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: mamba_gate_norm | bindings: y,projected,norm | push: inner,norm_groups,rows,proj_stride,proj_gate_off,eps | grid: [norm_groups, rows, 1]
// Mamba-2 gated group RMS norm (end of `mamba_forward` in rust_decoder.rs), in place on y (rows x inner): v = y * silu(gate), then for every group of
// size = inner / norm_groups values  y = v * (1 / sqrt(mean(v^2) + eps)) * norm[g * size + i]. gate = projected[t * proj_stride + proj_gate_off + i].
// One workgroup per (group, row); for the whole batch at once (no recurrent state involved).
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer YBuf { float y[]; };
layout(std430, binding = 1) readonly buffer ProjBuf { float projected[]; };
layout(std430, binding = 2) readonly buffer NormBuf { float norm_w[]; };
layout(push_constant) uniform P {
    uint inner;
    uint norm_groups;
    uint rows;
    uint proj_stride;
    uint proj_gate_off;
    float eps;
} p;

#include "_ops_reduce.glsl"

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint g = gl_WorkGroupID.x;
    const uint row = gl_WorkGroupID.y;
    if (row >= p.rows) return;
    const uint size = p.inner / p.norm_groups;
    float ss = 0.0;
    for (uint i = lane; i < size; i += WG) {
        const float v = y[row * p.inner + g * size + i] * silu(projected[row * p.proj_stride + p.proj_gate_off + g * size + i]);
        ss += v * v;
    }
    ss = wg_sum(ss);
    const float inv = 1.0 / sqrt(ss / float(size) + p.eps);
    for (uint i = lane; i < size; i += WG) {
        const float v = y[row * p.inner + g * size + i] * silu(projected[row * p.proj_stride + p.proj_gate_off + g * size + i]);
        y[row * p.inner + g * size + i] = v * inv * norm_w[g * size + i];
    }
}
