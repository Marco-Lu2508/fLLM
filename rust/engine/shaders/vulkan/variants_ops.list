# Variants of the non-matmul Vulkan shaders (package 3). Line: <output name> <source.comp> [-DNAME=VALUE ...]; # starts a comment.
# Sources named here are compiled ONLY under the names listed (build.rs); everything else in this directory is compiled once under its file name.

# activations (act_glu.comp, MODE: 0 swiglu, 1 geglu, 2 swiglu_oai, 3 silu, 4 gelu, 5 relu2, 6 relu, 7 gelu_erf, 8 geglu_erf, 9 reglu, 10 reglu2)
act_swiglu act_glu.comp -DMODE=0
act_geglu act_glu.comp -DMODE=1
act_swiglu_oai act_glu.comp -DMODE=2
act_silu act_glu.comp -DMODE=3
act_gelu act_glu.comp -DMODE=4
act_relu2 act_glu.comp -DMODE=5
act_relu act_glu.comp -DMODE=6
act_gelu_erf act_glu.comp -DMODE=7
act_geglu_erf act_glu.comp -DMODE=8
act_reglu act_glu.comp -DMODE=9
act_reglu2 act_glu.comp -DMODE=10
act_copy act_glu.comp -DMODE=11

# in-place element-wise operations (ewise.comp, MODE: 0 clamp, 1 softplus gate, 2 scale; act_head_gate.comp, MODE: 0 sigmoid, 1 softplus: per-head attention gate) and MLA data movement (mla_move.comp, MODE: 0 q, 1 k, 2 v, 3 latent)
ewise_clamp ewise.comp -DMODE=0
ewise_softplus ewise.comp -DMODE=1
ewise_scale ewise.comp -DMODE=2
act_head_gate_sigmoid act_head_gate.comp -DMODE=0
act_head_gate_softplus act_head_gate.comp -DMODE=1
mla_move_q mla_move.comp -DMODE=0
mla_move_k mla_move.comp -DMODE=1
mla_move_v mla_move.comp -DMODE=2
mla_move_latent mla_move.comp -DMODE=3

misc_dsa_scores misc_dsa_scores.comp
misc_dsa_scores_v4 misc_dsa_scores.comp -DVEC4=1

# embedding lookup: raw float tables and the planar quantized layouts
embed_f32 embed.comp -DRAW_F32
embed_f16 embed.comp -DRAW_F16
embed_bf16 embed.comp -DRAW_BF16
embed_q4_0 embed.comp -DFMT_Q4_0
embed_q4_1 embed.comp -DFMT_Q4_1
embed_q5_0 embed.comp -DFMT_Q5_0
embed_q5_1 embed.comp -DFMT_Q5_1
embed_q8_0 embed.comp -DFMT_Q8_0
embed_q2_k embed.comp -DFMT_Q2_K
embed_q3_k embed.comp -DFMT_Q3_K
embed_q4_k embed.comp -DFMT_Q4_K
embed_q5_k embed.comp -DFMT_Q5_K
embed_q6_k embed.comp -DFMT_Q6_K
embed_iq4_nl embed.comp -DFMT_IQ4_NL
embed_mxfp4 embed.comp -DFMT_MXFP4

# expert matrix-vector product: weights of all experts in one buffer (_arena) or reached through buffer device addresses (_bda)
moe_linear_q4_0_arena moe_linear.comp -DMOE_ARENA -DFMT_Q4_0
moe_linear_q4_1_arena moe_linear.comp -DMOE_ARENA -DFMT_Q4_1
moe_linear_q5_0_arena moe_linear.comp -DMOE_ARENA -DFMT_Q5_0
moe_linear_q5_1_arena moe_linear.comp -DMOE_ARENA -DFMT_Q5_1
moe_linear_q8_0_arena moe_linear.comp -DMOE_ARENA -DFMT_Q8_0
moe_linear_q2_k_arena moe_linear.comp -DMOE_ARENA -DFMT_Q2_K
moe_linear_q3_k_arena moe_linear.comp -DMOE_ARENA -DFMT_Q3_K
moe_linear_q4_k_arena moe_linear.comp -DMOE_ARENA -DFMT_Q4_K
moe_linear_q5_k_arena moe_linear.comp -DMOE_ARENA -DFMT_Q5_K
moe_linear_q6_k_arena moe_linear.comp -DMOE_ARENA -DFMT_Q6_K
moe_linear_iq4_nl_arena moe_linear.comp -DMOE_ARENA -DFMT_IQ4_NL
moe_linear_mxfp4_arena moe_linear.comp -DMOE_ARENA -DFMT_MXFP4
moe_linear_q4_0_bda moe_linear.comp -DMOE_BDA -DFMT_Q4_0
moe_linear_q4_1_bda moe_linear.comp -DMOE_BDA -DFMT_Q4_1
moe_linear_q5_0_bda moe_linear.comp -DMOE_BDA -DFMT_Q5_0
moe_linear_q5_1_bda moe_linear.comp -DMOE_BDA -DFMT_Q5_1
moe_linear_q8_0_bda moe_linear.comp -DMOE_BDA -DFMT_Q8_0
moe_linear_q2_k_bda moe_linear.comp -DMOE_BDA -DFMT_Q2_K
moe_linear_q3_k_bda moe_linear.comp -DMOE_BDA -DFMT_Q3_K
moe_linear_q4_k_bda moe_linear.comp -DMOE_BDA -DFMT_Q4_K
moe_linear_q5_k_bda moe_linear.comp -DMOE_BDA -DFMT_Q5_K
moe_linear_q6_k_bda moe_linear.comp -DMOE_BDA -DFMT_Q6_K
moe_linear_iq4_nl_bda moe_linear.comp -DMOE_BDA -DFMT_IQ4_NL
moe_linear_mxfp4_bda moe_linear.comp -DMOE_BDA -DFMT_MXFP4

# paged attention: decode / short batches with split-KV (KV_Q8 = cache format), prompt tiles (DVMAX = largest value width)
attn_decode_f16 attn_decode.comp -DKV_Q8=0
attn_decode_q8 attn_decode.comp -DKV_Q8=1
attn_prefill_f16_d128 attn_prefill.comp -DKV_Q8=0 -DDVMAX=128
attn_prefill_f16_d256 attn_prefill.comp -DKV_Q8=0 -DDVMAX=256
attn_prefill_f16_d512 attn_prefill.comp -DKV_Q8=0 -DDVMAX=512
attn_prefill_q8_d128 attn_prefill.comp -DKV_Q8=1 -DDVMAX=128
attn_prefill_q8_d256 attn_prefill.comp -DKV_Q8=1 -DDVMAX=256
attn_prefill_q8_d512 attn_prefill.comp -DKV_Q8=1 -DDVMAX=512
# 64 query rows per workgroup (512 invocations) where the device allows it
attn_prefill_f16_d128_r64 attn_prefill.comp -DKV_Q8=0 -DDVMAX=128 -DBR=64
attn_prefill_f16_d256_r64 attn_prefill.comp -DKV_Q8=0 -DDVMAX=256 -DBR=64
attn_prefill_f16_d512_r64 attn_prefill.comp -DKV_Q8=0 -DDVMAX=512 -DBR=64
attn_prefill_q8_d128_r64 attn_prefill.comp -DKV_Q8=1 -DDVMAX=128 -DBR=64
attn_prefill_q8_d256_r64 attn_prefill.comp -DKV_Q8=1 -DDVMAX=256 -DBR=64
attn_prefill_q8_d512_r64 attn_prefill.comp -DKV_Q8=1 -DDVMAX=512 -DBR=64
# the same on cooperative matrices (NVIDIA): f16 cache, key width = value width DK
attn_prefill_cm_d128 attn_prefill_cm.comp -DDK=128
attn_prefill_cm_d64 attn_prefill_cm.comp -DDK=64

# Gated DeltaNet recurrence per key width HK (value width is a run-time parameter, <= 128)
delta_rec_hk32 delta_rec.comp -DHK=32
delta_rec_hk64 delta_rec.comp -DHK=64
delta_rec_hk96 delta_rec.comp -DHK=96
delta_rec_hk128 delta_rec.comp -DHK=128
# the same recurrence for 16 value columns per workgroup through subgroup shuffles (no barrier per token), and the gated norm after it
delta_recc_hk32 delta_rec_cols.comp -DHK=32
delta_recc_hk64 delta_rec_cols.comp -DHK=64
delta_recc_hk96 delta_rec_cols.comp -DHK=96
delta_recc_hk128 delta_rec_cols.comp -DHK=128
delta_gnorm delta_gnorm.comp

# Mamba selective scans: NS = state size kept in registers, gen = any state size (state in memory)
mamba_scan2_ns16 mamba_scan2.comp -DNS=16
mamba_scan2_ns32 mamba_scan2.comp -DNS=32
mamba_scan2_ns64 mamba_scan2.comp -DNS=64
mamba_scan2_ns128 mamba_scan2.comp -DNS=128
mamba_scan2_gen mamba_scan2.comp -DNS=0
mamba_scan1_ns8 mamba_scan1.comp -DNS=8
mamba_scan1_ns16 mamba_scan1.comp -DNS=16
mamba_scan1_ns32 mamba_scan1.comp -DNS=32
mamba_scan1_gen mamba_scan1.comp -DNS=0

# RWKV-6 / RWKV-7 recurrences: N = head size kept in registers (rwkv7_wkv.comp, rwkv6_wkv.comp)
rwkv7_wkv_n16 rwkv7_wkv.comp -DN=16
rwkv7_wkv_n32 rwkv7_wkv.comp -DN=32
rwkv7_wkv_n64 rwkv7_wkv.comp -DN=64
rwkv7_wkv_n128 rwkv7_wkv.comp -DN=128
rwkv6_wkv_n16 rwkv6_wkv.comp -DN=16
rwkv6_wkv_n32 rwkv6_wkv.comp -DN=32
rwkv6_wkv_n64 rwkv6_wkv.comp -DN=64
rwkv6_wkv_n128 rwkv6_wkv.comp -DN=128

# Kimi Delta Attention recurrence per head width HK (the convolution is delta_conv)
kda_rec_hk16 kda_rec.comp -DHK=16
kda_rec_hk32 kda_rec.comp -DHK=32
kda_rec_hk64 kda_rec.comp -DHK=64
kda_rec_hk128 kda_rec.comp -DHK=128
