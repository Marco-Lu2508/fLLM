#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: misc_q4_ple_gate | bindings: out,key,query,value | push: pairs,hc,hidden | grid: [pairs = rows * hc split over x/y (x <= 65535), 1, 1]
// Stream::q4_ple_gate (Qwen3.8-Flash-Next hashed n-gram embedding), one workgroup of 128 per (row, stream) pair `rn`:
//   s = dot(key[rn], query[rn]) / sqrt(hidden), g = sign(s) * sqrt(max(|s|, 1e-6)) (0 for s = 0), out[rn][d] = sigmoid(g) * value[rn / hc][d]
#define WG 128
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer OutBuf { float outv[]; };
layout(std430, binding = 1) readonly buffer KeyBuf { float key[]; };
layout(std430, binding = 2) readonly buffer QueryBuf { float query[]; };
layout(std430, binding = 3) readonly buffer ValueBuf { float value[]; };
layout(push_constant) uniform P {
    uint pairs;
    uint hc;
    uint hidden;
} p;

#include "_ops_reduce.glsl"

void main() {
    const uint rn = group_index();
    if (rn >= p.pairs) return;
    const uint lane = gl_LocalInvocationID.x;
    const uint r = rn / p.hc;
    float dotp = 0.0;
    for (uint d = lane; d < p.hidden; d += WG) dotp += key[rn * p.hidden + d] * query[rn * p.hidden + d];
    const float total = wg_sum(dotp);
    float g = total / sqrt(float(p.hidden));
    g = sqrt(max(abs(g), 1e-6)) * (g == 0.0 ? 0.0 : (g > 0.0 ? 1.0 : -1.0));
    const float gate = sigmoid1(g);
    for (uint d = lane; d < p.hidden; d += WG) outv[rn * p.hidden + d] = gate * value[r * p.hidden + d];
}
