#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: misc_residual | bindings: x,residual | push: count,scale | grid: [min(ceil(count/256), 65535), 1, 1]
// Stream::residual_add: x[i] += residual[i] * scale in place (grid-stride loop over count floats).
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer XBuf { float x[]; };
layout(std430, binding = 1) readonly buffer ResBuf { float res[]; };
layout(push_constant) uniform P {
    uint count;
    float scale;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
        x[i] = x[i] + res[i] * p.scale;
    }
}
