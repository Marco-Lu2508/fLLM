#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: scan_state | bindings: scratch,state | push: hk,hv,heads,flags,n,reset,slots,state_off,hstride,kstride,vstride | grid: [heads, ceil(hv/32), 1] per run window
// Chunk-parallel scan (see _scan_common.glsl), step 5, the serial part (port of scan_state_kernel in cuda/scan.cu): the state of 32 value columns of one head
// lives in shared memory while the workgroup walks the chunks of the run window in order:
//   R = R0 + Wr P,   O = O0 + Qe P,   P = diag(dE) P + Kd^T V - Bd^T R
// O goes to the output part of the scratch. hk <= 128. The state element (h, i, j) (key channel i, value channel j) is state[state_off + h * hstride + i * kstride
// + j * vstride] (float view of the sequence's state buffer); reset != 0 ignores the old state.
#define WG 256
#include "_ops_common.glsl"
#include "_scan_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer ScratchBuf { float sc[]; };
layout(std430, binding = 1) buffer StateBuf { float state[]; };
layout(push_constant) uniform P {
    uint hk;
    uint hv;
    uint heads;
    uint flags;
    uint n;
    uint reset;
    uint slots;
    uint state_off;
    uint hstride;
    uint kstride;
    uint vstride;
} p;

const uint PS = 33u;
shared float sP[128 * 33];
shared float sRm[64 * 33];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint h = gl_WorkGroupID.x;
    const uint c0 = gl_WorkGroupID.y * SCW;
    const uint hk = p.hk;
    const uint hv = p.hv;
    const uint ncol = min(SCW, hv - c0);
    const bool r1 = (p.flags & SF_RANK1) != 0u;
    const ScanLay y = scan_layout(hk, hv, p.heads, p.flags, p.slots);
    const uint sbase = p.state_off + h * p.hstride;
    for (uint e = tid; e < hk * SCW; e += WG) {
        const uint i = e / SCW;
        const uint c = e % SCW;
        sP[i * PS + c] = (p.reset != 0u || c >= ncol) ? 0.0 : state[sbase + i * p.kstride + (c0 + c) * p.vstride];
    }
    const uint nch = (p.n + SC - 1u) / SC;
    const uint t = tid & 63u;
    const uint cg = tid >> 6u;
    for (uint ch = 0u; ch < nch; ch++) {
        const uint L = min(SC, p.n - ch * SC);
        const uint lr0 = ch * SC;
        const uint w = y.ws + (ch * p.heads + h) * y.chunk;
        wg_sync();
        float ar[8];
        float ao[8];
        [[unroll]] for (uint k = 0u; k < 8u; k++) {
            const uint c = cg * 8u + k;
            ar[k] = (r1 && c < ncol) ? sc[w + y.o_r0 + t * hv + c0 + c] : 0.0;
            ao[k] = (c < ncol) ? sc[w + y.o_o0 + t * hv + c0 + c] : 0.0;
        }
        const uint wr = w + y.o_wr + t * hk;
        const uint qe = w + y.o_qe + t * hk;
        for (uint i = 0u; i < hk; i++) {
            const float qv = sc[qe + i];
            const float wv = r1 ? sc[wr + i] : 0.0;
            [[unroll]] for (uint k = 0u; k < 8u; k++) {
                const float pv = sP[i * PS + cg * 8u + k];
                ao[k] += qv * pv;
                ar[k] += wv * pv;
            }
        }
        [[unroll]] for (uint k = 0u; k < 8u; k++) {
            const uint c = cg * 8u + k;
            sRm[t * PS + c] = ar[k];
            if (t < L && c < ncol) sc[y.o + ((lr0 + t) * p.heads + h) * hv + c0 + c] = ao[k];
        }
        wg_sync();
        for (uint item = tid; item < hk * 4u; item += WG) {
            const uint i = item % hk;
            const uint g = item / hk;
            const float de = sc[w + y.o_de + i];
            float acc[8];
            [[unroll]] for (uint k = 0u; k < 8u; k++) acc[k] = sP[i * PS + g * 8u + k] * de;
            for (uint s = 0u; s < L; s++) {
                const float kv = sc[w + y.o_kd + s * hk + i];
                const float bv = r1 ? sc[w + y.o_bd + s * hk + i] : 0.0;
                const uint vrow = y.v + ((lr0 + s) * p.heads + h) * hv + c0 + g * 8u;
                [[unroll]] for (uint k = 0u; k < 8u; k++) {
                    const float vv = (g * 8u + k < ncol) ? sc[vrow + k] : 0.0;
                    acc[k] += kv * vv - bv * sRm[s * PS + g * 8u + k];
                }
            }
            [[unroll]] for (uint k = 0u; k < 8u; k++) sP[i * PS + g * 8u + k] = acc[k];
        }
    }
    wg_sync();
    if (nch > 0u) {
        for (uint e = tid; e < hk * SCW; e += WG) {
            const uint i = e / SCW;
            const uint c = e % SCW;
            if (c < ncol) state[sbase + i * p.kstride + (c0 + c) * p.vstride] = sP[i * PS + c];
        }
    }
}
