#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: misc_rotate_heads | bindings: x,out | push: count,dim,shift | grid: [min(ceil(count/256), 65535), 1, 1]
// Tail rotation of groups of dim floats (Stream::rotate_heads; the indexer heads of Hy4): out[g * dim + (d + shift) % dim] = x[g * dim + d], so the last
// `shift` values of every group move to the front. Grid-stride loop over count floats.
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer XBuf { float x[]; };
layout(std430, binding = 1) buffer OutBuf { float outv[]; };
layout(push_constant) uniform P {
    uint count;
    uint dim;
    uint shift;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
        const uint g = i / p.dim;
        const uint d = i % p.dim;
        outv[g * p.dim + (d + p.shift) % p.dim] = x[i];
    }
}
