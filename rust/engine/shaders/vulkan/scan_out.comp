#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: scan_out | bindings: scratch | push: hk,hv,heads,flags,n,reset,slots | grid: [ceil(n/64), heads * ceil(ncols/64), 1] per run window
// Chunk-parallel scan (see _scan_common.glsl), step 4 (port of scan_out_kernel in cuda/scan.cu); ncols = hk + hv with rank-one terms (the first hk columns
// correct Qe), else hv. One invocation per column, the 64 tokens in order:
//   Qe[t][i] -= sum_{s<=t} Qb[t][s] Wr[s][i]
//   O0[t][j]  = c_t v[t][j] + sum_{s<=t} Qk[t][s] v[s][j] - sum_{s<=t} Qb[t][s] R0[s][j]
#define WG 64
#include "_ops_common.glsl"
#include "_scan_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer ScratchBuf { float sc[]; };
layout(push_constant) uniform P {
    uint hk;
    uint hv;
    uint heads;
    uint flags;
    uint n;
    uint reset;
    uint slots;
} p;

void main() {
    const uint ch = gl_WorkGroupID.x;
    const uint t0 = ch * SC;
    if (t0 >= p.n) return;
    const bool r1 = (p.flags & SF_RANK1) != 0u;
    const uint ncols = r1 ? p.hk + p.hv : p.hv;
    const uint colblocks = (ncols + 63u) / 64u;
    const uint h = gl_WorkGroupID.y / colblocks;
    const uint col = (gl_WorkGroupID.y % colblocks) * 64u + gl_LocalInvocationID.x;
    if (col >= ncols) return;
    const uint L = min(SC, p.n - t0);
    const ScanLay y = scan_layout(p.hk, p.hv, p.heads, p.flags, p.slots);
    const uint hk = p.hk;
    const uint hv = p.hv;
    const uint w = y.ws + (ch * p.heads + h) * y.chunk;
    if (r1 && col < hk) {
        const uint qe = w + y.o_qe + col;
        const uint wr = w + y.o_wr + col;
        for (uint t = 0u; t < L; t++) {
            float x = sc[qe + t * hk];
            for (uint s = 0u; s <= t; s++) x -= sc[w + y.o_qb + t * SC + s] * sc[wr + s * hk];
            sc[qe + t * hk] = x;
        }
        return;
    }
    const uint j = r1 ? col - hk : col;
    const uint o0 = w + y.o_o0 + j;
    const uint r0 = w + y.o_r0 + j;
    const uint vb = y.v + (t0 * p.heads + h) * hv + j;
    const uint vs = p.heads * hv;
    const bool hc = (p.flags & SF_HASC) != 0u;
    const uint cc = y.c + t0 * p.heads + h;
    const uint early = (p.flags & SF_QPREV) != 0u ? 1u : 0u;
    for (uint t = 0u; t < L; t++) {
        float x = hc ? sc[cc + t * p.heads] * sc[vb + t * vs] : 0.0;
        for (uint s = 0u; s + early <= t; s++) x += sc[w + y.o_qk + t * SC + s] * sc[vb + s * vs];
        if (r1) {
            for (uint s = 0u; s <= t; s++) x -= sc[w + y.o_qb + t * SC + s] * sc[r0 + s * hv];
        }
        sc[o0 + t * hv] = x;
    }
}
