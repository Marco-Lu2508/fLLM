#version 450
// FLLM-SHADER: mm_<fmt>_cw | bindings: 0 weights(u32[]) 1 xh(uvec4[], batch x cols binary16, written by the prepass quant_act_f16) 2 out(f32[]) 3 bias(f32[]) | push: QPush(48 B) | grid: ceil(rows/128) x ceil(batch/64) x 1
// Wide variant of mm_coopmat.comp for devices with 32-wide subgroups and plenty of shared memory (NVIDIA): the same cooperative-matrix product
// (VK_KHR_cooperative_matrix, 16x16x16 float16 inputs, float32 accumulators) with a larger output tile per workgroup of NSGM x NSGN subgroups
// (macros BM x BN, K step BK; default 128 x 64, K step 64, 8 subgroups of 32 x 32), so every dequantized weight is reused for more activation rows and every converted activation for more weight rows,
// and the packed weights and (binary16) activations of the NEXT K step are fetched into registers before the matrix multiply-adds of the current step, so their
// memory latency overlaps the tensor cores. Subgroup s computes the (BM / NSGM) x (BN / NSGN) sub-tile at weight rows (s % NSGM) * (BM / NSGM) and
// activation rows (s / NSGM) * (BN / NSGN).
// The workgroups are dispatched as a (row blocks) x (token tiles) grid but numbered with the token tiles of one block of rows next to each other (see main()), and the scale
// words of a Q4_K super-block are loaded once per four K steps and turned into floats only after the matrix products of the step, so that no arithmetic waits for them.
// Requires: shaderFloat16, cooperativeMatrix 16x16x16 (float16 A/B, float32 C/Result, subgroup scope), subgroup size 32 (the planner checks it).
#extension GL_GOOGLE_include_directive : enable
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#define FLLM_NO_HW_DOT 1
#include "_q_ext.glsl"

#ifndef BM
#define BM 128
#endif
#ifndef BN
#define BN 64
#endif
#ifndef BK
#define BK 64
#endif
#ifndef NSGM
#define NSGM 4
#endif
#ifndef NSGN
#define NSGN 2
#endif
#define NSG (NSGM * NSGN)
#define WG (NSG * 32u)
#define WM (BM / NSGM)   // sub-tile of one subgroup
#define WN (BN / NSGN)
#define FM (WM / 16)     // 16 x 16 fragments of it
#define FN (WN / 16)
#define LDS (BK + 8u)    // row stride of the f16 tiles in elements (keeps 16-byte alignment, no bank conflicts)
#define CPR (BK / 8u)    // weight chunks per tile row
#define QPR (BK / 8u)    // activation uvec4 (8 halves) per tile row
#define WITEMS ((BM * CPR) / WG)   // weight chunks per invocation and K step
#define XITEMS ((BN * QPR) / WG)   // activation uvec4 per invocation and K step

// Q4_K with a K step of 64 has its own weight loader: one K step of a row is exactly one pair of scale groups, 32 bytes of qs whose low nibbles are the first and
// whose high nibbles are the second group of 32 values. An invocation reads 16 of those bytes with one wide load and the scales, minimums and d / dmin of the
// pair once (instead of two words, a scale word, a minimum word and the d word for every chunk of 8 weights).
#if defined(FMT_Q4_K) && !defined(FLLM_NO_Q4K_LOADER)
#define Q4K_LOADER 1
#if BK != 64
#error "the Q4_K loader needs a K step of 64"
#endif
#endif

// Q6_K has its own weight loader too: the raw words of a chunk of 8 weights (low bits, high bits, scale word, d) are loaded in fetch() and decoded in stash(), after the
// matrix products, so no arithmetic waits for the loads.
#if defined(FMT_Q6_K) && !defined(FLLM_NO_Q6K_LOADER)
#define Q6K_LOADER 1
#endif

layout(local_size_x = 32 * NSGM * NSGN, local_size_y = 1, local_size_z = 1) in;

#include "_q_common.glsl"
#include "_q_formats.glsl"
#ifdef FLOAT_CHUNK
#error "float-chunk formats (FP8, NF4, FP4) have only the f32 shaders"
#endif

layout(std430, set = 0, binding = 1) readonly buffer XBuf { uvec4 xh[]; };
layout(std430, set = 0, binding = 2) writeonly buffer OutBuf { float outv[]; };
layout(std430, set = 0, binding = 3) readonly buffer BiasBuf { float biasv[]; };

// the f16 tiles are arrays of f16vec4 (a chunk of 8 weights is two 8-byte stores, not eight 2-byte stores)
shared f16vec4 As[BM * LDS / 4u];   // As[m * LDS + k] in halves
shared f16vec4 Bs[BN * LDS / 4u];   // Bs[n * LDS + k] in halves
shared float Cs[NSG * 256];         // one 16 x 16 staging tile per subgroup

#ifdef Q4K_LOADER
#define QITEMS ((BM * 2u) / WG)   // (row, half) units per invocation and K step
uvec4 r_q[QITEMS];
uvec4 r_sv[QITEMS]; // the scale words (x, y) and minimum words (z, w) of the row's super-block, and its d / dmin word: loaded once per super-block (every fourth K step),
uint r_d[QITEMS];   // turned into floats in stash(), after the matrix products, so no arithmetic waits for these loads and they stay in flight while the tensor cores work
#elif defined(Q6K_LOADER)
uvec4 r_l[WITEMS];   // ql words (x, y) and qh words (z, w) of the chunk of 8 weights
uvec2 r_t[WITEMS];   // the word with the chunk's scale and the bits of the block's d
#else
uint r_p0[WITEMS];
uint r_p1[WITEMS];
float r_ws[WITEMS];
float r_wm[WITEMS];
#endif
uvec4 r_x[XITEMS];

// the packed weights and the activations of K step k0 into registers
void fetch(uint k0, uint t, uint m0, uint n0) {
#ifdef Q4K_LOADER
    [[unroll]] for (uint e = 0; e < QITEMS; ++e) {
        const uint i = t + e * WG;
        const uint row = m0 + (i >> 1);
        uvec4 q = uvec4(0u);
        if (row < p.rows) {
            const uint g = row * p.nb + (k0 >> 8);
            const uint pair = (k0 >> 6) & 3u;
            const uint q0 = g * 32u + pair * 8u + (i & 1u) * 4u;
            q = uvec4(w[q0], w[q0 + 1u], w[q0 + 2u], w[q0 + 3u]);
            if (pair == 0u) {   // the scales of a super-block serve its four K steps
                const uint q1 = p.off1 + g * 4u;
                r_sv[e] = uvec4(w[q1], w[q1 + 1u], w[q1 + 2u], w[q1 + 3u]);
                r_d[e] = w[p.off2 + g];
            }
        } else {
            r_sv[e] = uvec4(0u);
            r_d[e] = 0u;
        }
        r_q[e] = q;
    }
#elif defined(Q6K_LOADER)
    [[unroll]] for (uint e = 0; e < WITEMS; ++e) {
        const uint i = t + e * WG;
        const uint row = m0 + i / CPR;
        const uint kk = k0 + (i % CPR) * 8u;
        uvec4 l = uvec4(0u);
        uvec2 tt = uvec2(0u);
        if (row < p.rows) {
            const uint g = row * p.nb + kk / QK;
            const uint cin = (kk % QK) >> 3;
            const uint n = cin >> 4;
            const uint r = cin & 15u;
            const uint grp = r >> 2;
            const uint j4 = r & 3u;
            const uint b = g * 32u + (n << 4) + ((grp & 1u) << 3) + (j4 << 1);
            const uint h = p.off1 + g * 16u + (n << 3) + (j4 << 1);
            const uint si = (n << 3) + (j4 >> 1) + (grp << 1);
            l = uvec4(w[b], w[b + 1u], w[h], w[h + 1u]);
            tt = uvec2(w[p.off2 + g * 4u + (si >> 2)], w[p.off3 + g]);
        }
        r_l[e] = l;
        r_t[e] = tt;
    }
#else
    [[unroll]] for (uint e = 0; e < WITEMS; ++e) {
        const uint i = t + e * WG;
        const uint row = m0 + i / CPR;
        const uint kk = k0 + (i % CPR) * 8u;
        uint p0 = 0u, p1 = 0u;
        float ws = 0.0, wm = 0.0;
        if (row < p.rows) wchunk(row * p.nb + kk / QK, (kk % QK) >> 3, p0, p1, ws, wm);
        r_p0[e] = p0;
        r_p1[e] = p1;
        r_ws[e] = ws;
        r_wm[e] = wm;
    }
#endif
    [[unroll]] for (uint e = 0; e < XITEMS; ++e) {
        const uint i = t + e * WG;
        const uint token = n0 + i / QPR;
        uvec4 v = uvec4(0u);
        if (token < p.batch) v = xh[(token * p.cols + k0 + (i % QPR) * 8u) >> 3];
        r_x[e] = v;
    }
}

// the registers to the shared f16 tiles
void stash(uint t, uint k0) {
#ifdef Q4K_LOADER
    [[unroll]] for (uint e = 0; e < QITEMS; ++e) {
        const uint i = t + e * WG;
        const uint base = (((i >> 1) * LDS) + (i & 1u) * 16u) >> 2;   // first group at tile columns 0 .. 31, the second at 32 .. 63
        // scale and minimum of the first group, then of the second group: weight = k.x * q + k.y, k.z * q + k.w
        const uint sh = ((k0 >> 6) & 1u) << 4;
        const bool hi = ((k0 >> 7) & 1u) != 0u;   // scale groups 4 .. 7 of the super-block sit in the second word
        const uint scw = (hi ? r_sv[e].y : r_sv[e].x) >> sh;
        const uint mnw = (hi ? r_sv[e].w : r_sv[e].z) >> sh;
        const vec2 dm = unpackHalf2x16(r_d[e]);
        const vec4 kq = vec4(dm.x * float(scw & 255u), -dm.y * float(mnw & 255u), dm.x * float((scw >> 8) & 255u), -dm.y * float((mnw >> 8) & 255u));
        const vec4 ka = vec4(kq.x);
        const vec4 ma = vec4(kq.y);
        const vec4 kb = vec4(kq.z);
        const vec4 mb = vec4(kq.w);
        [[unroll]] for (uint c = 0; c < 4u; ++c) {
            const uint x = r_q[e][c];
            const vec4 lo = vec4(uvec4(x, x >> 8, x >> 16, x >> 24) & 15u);
            const vec4 hi = vec4(uvec4(x >> 4, x >> 12, x >> 20, x >> 28) & 15u);
            As[base + c] = f16vec4(fma(lo, ka, ma));
            As[base + 8u + c] = f16vec4(fma(hi, kb, mb));
        }
    }
#elif defined(Q6K_LOADER)
    [[unroll]] for (uint e = 0; e < WITEMS; ++e) {
        const uint i = t + e * WG;
        const uint cin = (((k0 + (i % CPR) * 8u) % QK)) >> 3;
        const uint r = cin & 15u;
        const uint grp = r >> 2;
        const uint j4 = r & 3u;
        const uint sh = (grp >> 1) << 2;
        const uint hs = grp << 1;
        const uvec4 l = r_l[e];
        const uint p0 = sub8(((l.x >> sh) & 0x0F0F0F0Fu) | (((l.z >> hs) & 0x03030303u) << 4), 32u);
        const uint p1 = sub8(((l.y >> sh) & 0x0F0F0F0Fu) | (((l.w >> hs) & 0x03030303u) << 4), 32u);
        const uint si = ((cin >> 4) << 3) + (j4 >> 1) + (grp << 1);
        const int sc = bitfieldExtract(int(r_t[e].x), int((si & 3u) << 3), 8);
        const float ws = uintBitsToFloat(r_t[e].y) * float(sc);
        float vals[8];
        chunk_floats(p0, p1, ws, 0.0, vals);
        const uint base = ((i / CPR) * LDS + (i % CPR) * 8u) >> 2;
        As[base] = f16vec4(vals[0], vals[1], vals[2], vals[3]);
        As[base + 1u] = f16vec4(vals[4], vals[5], vals[6], vals[7]);
    }
#else
    [[unroll]] for (uint e = 0; e < WITEMS; ++e) {
        const uint i = t + e * WG;
        float vals[8];
        chunk_floats(r_p0[e], r_p1[e], r_ws[e], r_wm[e], vals);
        const uint base = ((i / CPR) * LDS + (i % CPR) * 8u) >> 2;
        As[base] = f16vec4(vals[0], vals[1], vals[2], vals[3]);
        As[base + 1u] = f16vec4(vals[4], vals[5], vals[6], vals[7]);
    }
#endif
    [[unroll]] for (uint e = 0; e < XITEMS; ++e) {
        const uint i = t + e * WG;
        const uint base = ((i / QPR) * LDS + (i % QPR) * 8u) >> 2;
        Bs[base] = f16vec4(unpackFloat2x16(r_x[e].x), unpackFloat2x16(r_x[e].y));
        Bs[base + 1u] = f16vec4(unpackFloat2x16(r_x[e].z), unpackFloat2x16(r_x[e].w));
    }
}

void main() {
    const uint t = gl_LocalInvocationID.x;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    // consecutive workgroups share a block of weight rows: all token tiles of one block run next to each other, so the block is fetched from memory once
    // and the other token tiles find it in the L2 cache (with the row blocks varying fastest, the whole weight matrix streams past between two token tiles
    // of the same rows and is read from memory once per token tile)
    const uint tok_tiles = (p.batch + BN - 1u) / BN;
    const uint wg_id = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const uint m0 = (wg_id / tok_tiles) * BM;
    const uint n0 = (wg_id % tok_tiles) * BN;
    const uint sm = (sg % NSGM) * WM;   // weight-row offset of this subgroup's sub-tile
    const uint sn = (sg / NSGM) * WN;   // activation-row offset

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[FM * FN];
    [[unroll]] for (uint i = 0; i < FM * FN; ++i) acc[i] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    fetch(0u, t, m0, n0);
    for (uint k0 = 0; k0 < p.cols; k0 += BK) {
        stash(t, k0);
        barrier();
        if (k0 + BK < p.cols) fetch(k0 + BK, t, m0, n0);
        [[unroll]] for (uint kk = 0; kk < BK / 16; ++kk) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma[FM];
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb[FN];
            [[unroll]] for (uint i = 0; i < FM; ++i)
                coopMatLoad(ma[i], As, ((sm + i * 16u) * LDS + kk * 16u) >> 2, LDS >> 2, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint j = 0; j < FN; ++j)
                coopMatLoad(mb[j], Bs, ((sn + j * 16u) * LDS + kk * 16u) >> 2, LDS >> 2, gl_CooperativeMatrixLayoutColumnMajor);
            [[unroll]] for (uint i = 0; i < FM; ++i) {
                [[unroll]] for (uint j = 0; j < FN; ++j) acc[i * FN + j] = coopMatMulAdd(ma[i], mb[j], acc[i * FN + j]);
            }
        }
        barrier();
    }

    // epilogue: stage each 16 x 16 accumulator through shared memory, apply scale and bias, write the output (row-contiguous)
    [[unroll]] for (uint i = 0; i < FM; ++i) {
        [[unroll]] for (uint j = 0; j < FN; ++j) {
            coopMatStore(acc[i * FN + j], Cs, sg * 256u, 16u, gl_CooperativeMatrixLayoutColumnMajor);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            for (uint idx = lane; idx < 256u; idx += 32u) {
                const uint m = idx & 15u;
                const uint n = idx >> 4;
                const uint row = m0 + sm + i * 16u + m;
                const uint token = n0 + sn + j * 16u + n;
                if (row < p.rows && token < p.batch) {
                    float v = Cs[sg * 256u + idx] * p.scale;
                    if ((p.flags & 1u) != 0u) v += biasv[p.row_base + row];
                    outv[token * p.out_stride + p.row_base + row] = v;
                }
            }
            subgroupMemoryBarrierShared();
            subgroupBarrier();
        }
    }
}
