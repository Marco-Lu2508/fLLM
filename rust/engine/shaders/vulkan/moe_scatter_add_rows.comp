#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: moe_scatter_add_rows | bindings: dst,src,idx,weights | push: n,row_len,has_weights | grid: [min(ceil(n*row_len/256), 65535), 1, 1]
// Stream::scatter_add_rows: dst[idx[i]] += src[i] * weights[i] (weights optional: has_weights = 0 means 1) for i < n rows of row_len floats. The rows of
// one call have distinct destinations (Stream contract), so a plain read-modify-write is enough.
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer DstBuf { float dst[]; };
layout(std430, binding = 1) readonly buffer SrcBuf { float src[]; };
layout(std430, binding = 2) readonly buffer IdxBuf { int idx[]; };
layout(std430, binding = 3) readonly buffer WeightBuf { float weights[]; };
layout(push_constant) uniform P {
    uint n;
    uint row_len;
    uint has_weights;
} p;

void main() {
    const uint total = p.n * p.row_len;
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < total; i += grid_items) {
        const uint r = i / p.row_len;
        const uint c = i - r * p.row_len;
        const float w = p.has_weights != 0u ? weights[r] : 1.0;
        dst[uint(idx[r]) * p.row_len + c] += w * src[i];
    }
}
