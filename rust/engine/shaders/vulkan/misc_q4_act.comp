#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: misc_q4_act | bindings: x | push: count,mode,scale,factor | grid: [min(ceil(count/256), 65535), 1, 1]
// Stream::q4_act (Qwen3.8-Flash-Next), in place over count floats: x = factor * act(x * scale), mode 0 SiLU, mode 1 sigmoid.
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer XBuf { float x[]; };
layout(push_constant) uniform P {
    uint count;
    uint mode;
    float scale;
    float factor;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
        const float v = x[i] * p.scale;
        x[i] = p.factor * (p.mode == 0u ? silu(v) : sigmoid1(v));
    }
}
