// Pure helpers of the IQ1 / IQ2 / IQ3 chunk decoders (_q_fmt_iq*.glsl, _ops_wq.glsl): no buffer access, so the quantized-linear shaders and the
// embedding / expert shaders share them. The grids are in _iq_grid_*.glsl (generated by scripts/gen_vulkan_iq_tables.py).
// A chunk is 8 values = lanes 0..3 of p0 and lanes 0..3 of p1 (int8 each). Sign fields: bit j set = value j negative.
#ifndef FLLM_IQ_COMMON
#define FLLM_IQ_COMMON

// ksigns_iq2xs: a 7-bit sign field -> 8 bits with even parity (the eighth sign is implied)
uint iq_signs8(uint s7) {
    return s7 | ((bitCount(s7) & 1u) << 7);
}

// the low 4 bits of n -> 0xFF in every byte lane whose bit is set
uint iq_lanemask(uint n) {
    return (((n & 15u) * 0x00204081u) & 0x01010101u) * 255u;
}

// four lanes of magnitudes 1..127, negated where the sign bit s4 (4 bits) is set
uint iq_apply(uint v, uint s4) {
    uint m = iq_lanemask(s4);
    return (v ^ m) + (m & 0x01010101u);
}

// four 2-bit codes (the low 8 bits of x) -> one code per byte lane
uint iq_spread2(uint x) {
    return (x | (x << 6) | (x << 12) | (x << 18)) & 0x03030303u;
}

// code lanes 0, 1, 2 -> magnitudes 8, 25, 43 (the three levels of the IQ2 grids)
uint iq_mag2(uint c) {
    return 0x08080808u + c * 17u + ((c >> 1) & 0x01010101u);
}

// code lanes 0, 1, 2 -> -1, 0, 1 (the IQ1 grids)
uint iq_dec1(uint c) {
    return ((c | 0x80808080u) - 0x01010101u) ^ 0x80808080u;
}

// the 16-bit grid entry idx of a table of two entries per word, given the word idx / 2
uint iq_entry(uint tab_word, uint idx) {
    return (tab_word >> ((idx & 1u) << 4)) & 0xFFFFu;
}

#endif
