#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: rwkv_act | bindings: x,gate | push: count,mode | grid: [min(ceil(count/256), 65535), 1, 1]
// In-place activation of the RWKV blocks (Stream::rwkv_act), selected at run time by `mode`:
//   0 tanh   1 sigmoid   2 SiLU   3 ReLU squared   4 x * sigmoid(gate[i])   5 x * 0.5
// `gate` is read in mode 4 only (a dummy binding otherwise). Grid-stride loop over count floats.
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer XBuf { float x[]; };
layout(std430, binding = 1) readonly buffer GateBuf { float gate[]; };
layout(push_constant) uniform P {
    uint count;
    uint mode;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
        const float v = x[i];
        float o;
        if (p.mode == 0u) {
            o = tanh(clamp(v, -15.0, 15.0));
        } else if (p.mode == 1u) {
            o = sigmoid1(v);
        } else if (p.mode == 2u) {
            o = silu(v);
        } else if (p.mode == 3u) {
            const float r = max(v, 0.0);
            o = r * r;
        } else if (p.mode == 4u) {
            o = v * sigmoid1(gate[i]);
        } else {
            o = v * 0.5;
        }
        x[i] = o;
    }
}
