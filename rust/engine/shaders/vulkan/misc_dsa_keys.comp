#version 450
#extension GL_GOOGLE_include_directive : enable
// FLLM-SHADER: misc_dsa_keys | bindings: store,k,gate,slots | push: count,dim,width,has_gate | grid: [min(ceil(count/256), 65535), 1, 1]
// Indexer keys of the new tokens into the per-slot key store (Stream::dsa_select, DeepSeek-V3.2 / GLM-5): store[slots[r] * dim + d] = k[r * dim + d]
// for the count = rows * dim values (grid-stride loop). The store holds one width-wide f32 row per cache slot: the key and, for the k-pool indexer
// (has_gate = 1), the gate scores of the pooling at offset dim: store[slots[r] * width + dim + d] = gate[r * dim + d].
#define WG 256
#include "_ops_common.glsl"
layout(local_size_x = WG) in;

layout(std430, binding = 0) buffer StoreBuf { float store[]; };
layout(std430, binding = 1) readonly buffer KBuf { float kk[]; };
layout(std430, binding = 2) readonly buffer GateBuf { float gate[]; };
layout(std430, binding = 3) readonly buffer SlotBuf { uint slots[]; };
layout(push_constant) uniform P {
    uint count;
    uint dim;
    uint width;
    uint has_gate;
} p;

void main() {
    const uint grid_items = gl_NumWorkGroups.x * WG;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += grid_items) {
        const uint base = slots[i / p.dim] * p.width;
        store[base + i % p.dim] = kk[i];
        if (p.has_gate != 0u) store[base + p.dim + i % p.dim] = gate[i];
    }
}
