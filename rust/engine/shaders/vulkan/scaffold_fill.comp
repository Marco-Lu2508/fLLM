#version 450
// Scaffold shader: fills a float buffer with a constant (checks the toolchain and the pipeline code).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { float data[]; };
layout(push_constant) uniform P { uint n; float value; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) data[i] = p.value;
}
